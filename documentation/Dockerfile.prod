# Production Dockerfile for Abada Documentation
#
# The build context is the repository root (`./`), not `documentation/`, so
# the image can ship the repository LICENSE text:
#   docker build -f documentation/Dockerfile.prod -t abada-docs:local .
FROM node:24.18.0-alpine AS builder

WORKDIR /app

# Copy package files
COPY documentation/package.json documentation/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the application source code
COPY documentation/ ./

# Build the production bundle
RUN npm run build

# Production stage
FROM nginx:1.28.0-alpine

# Copy nginx configuration
COPY documentation/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Ship the licence text with the site (AGPL-3.0-only)
COPY LICENSE /licenses/LICENSE

# Expose port 5606
EXPOSE 5606

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
