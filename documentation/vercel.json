{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/architecture/bpmn",
      "destination": "/compatibility/bpmn",
      "permanent": true
    },
    {
      "source": "/architecture/bpmn/",
      "destination": "/compatibility/bpmn/",
      "permanent": true
    }
  ]
}
