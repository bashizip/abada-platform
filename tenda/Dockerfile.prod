# Production Dockerfile for Abada Tenda
FROM node:24.18.0-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --production=false

# Copy the rest of the application source code
COPY . .

# Build the production bundle
RUN npm run build

# Production stage
FROM nginx:1.28.0-alpine

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker-entrypoint.sh /usr/local/bin/abada-frontend-entrypoint
RUN chmod +x /usr/local/bin/abada-frontend-entrypoint

# Expose port 5602
EXPOSE 5602

# Start nginx
ENTRYPOINT ["/usr/local/bin/abada-frontend-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
