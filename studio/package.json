{
  "name": "abada-studio",
  "private": true,
  "version": "1.0.0-rc.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:apl-parity && npm run verify:kitchen-sink",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify:apl-parity": "tsx --tsconfig tsconfig.app.json scripts/check-apl-parity.mts",
    "verify:kitchen-sink": "tsx --tsconfig tsconfig.app.json scripts/kitchen-sink-roundtrip.mts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "fast-xml-parser": "^5.10.1",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^26.0.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
