<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_EventGatewayTest" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_FastTrack" name="FastTrackMessage" />
  <bpmn:process id="EventGatewayProcess" name="Event Gateway Test Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_to_SetKey</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SetKey" name="Set Correlation Key" camunda:candidateUsers="test-user">
      <bpmn:incoming>Flow_to_SetKey</bpmn:incoming>
      <bpmn:outgoing>Flow_to_EventGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="EventGateway" name="FastTrack or Timeout">
      <bpmn:incoming>Flow_to_EventGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_to_MessageEvent</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_TimerEvent</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="CatchEvent_OrderPaid" name="OrderPaid Event">
      <bpmn:incoming>Flow_to_MessageEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_to_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_FastTrack" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CatchEvent_Timeout" name="Timeout Event">
      <bpmn:incoming>Flow_to_TimerEvent</bpmn:incoming>
      <bpmn:outgoing>Flow_to_End</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration>PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_to_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_to_SetKey" sourceRef="StartEvent_1" targetRef="Task_SetKey" />
    <bpmn:sequenceFlow id="Flow_to_EventGateway" sourceRef="Task_SetKey" targetRef="EventGateway" />
    <bpmn:sequenceFlow id="Flow_to_MessageEvent" sourceRef="EventGateway" targetRef="CatchEvent_OrderPaid" />
    <bpmn:sequenceFlow id="Flow_to_TimerEvent" sourceRef="EventGateway" targetRef="CatchEvent_Timeout" />
    <bpmn:sequenceFlow id="Flow_to_End" sourceRef="CatchEvent_OrderPaid" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Timer_to_End" sourceRef="CatchEvent_Timeout" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="EventGatewayProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SetKey_di" bpmnElement="Task_SetKey">
        <dc:Bounds x="240" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EventGateway_di" bpmnElement="EventGateway">
        <dc:Bounds x="400" y="245" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchEvent_OrderPaid_di" bpmnElement="CatchEvent_OrderPaid">
        <dc:Bounds x="512" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchEvent_Timeout_di" bpmnElement="CatchEvent_Timeout">
        <dc:Bounds x="512" y="340" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="640" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_to_SetKey_di" bpmnElement="Flow_to_SetKey">
        <di:waypoint x="188" y="270" /><di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_EventGateway_di" bpmnElement="Flow_to_EventGateway">
        <di:waypoint x="340" y="270" /><di:waypoint x="400" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_MessageEvent_di" bpmnElement="Flow_to_MessageEvent">
        <di:waypoint x="425" y="245" /><di:waypoint x="425" y="178" /><di:waypoint x="512" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_TimerEvent_di" bpmnElement="Flow_to_TimerEvent">
        <di:waypoint x="425" y="295" /><di:waypoint x="425" y="358" /><di:waypoint x="512" y="358" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_End_di" bpmnElement="Flow_to_End">
        <di:waypoint x="548" y="178" /><di:waypoint x="658" y="178" /><di:waypoint x="658" y="252" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_to_End_di" bpmnElement="Flow_Timer_to_End">
        <di:waypoint x="548" y="358" /><di:waypoint x="658" y="358" /><di:waypoint x="658" y="288" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
