{
  "title": "Supplier onboarding",
  "fields": [
    { "id": "request_view", "type": "display", "label": "Request", "variable": "request_id" },
    { "id": "requested_by_view", "type": "display", "label": "Requested by", "variable": "requested_by" },
    { "id": "legal_name", "type": "string", "label": "Legal name", "required": true, "maxLength": 120 },
    { "id": "trading_name", "type": "string", "label": "Trading name" },
    { "id": "registration_no", "type": "string", "label": "Company registration no.", "required": true, "pattern": "[A-Z0-9-]{6,20}", "help": "As on the trade register extract" },
    { "id": "country", "type": "select", "label": "Country", "required": true, "options": ["Belgium", "France", "Germany", "Netherlands", "Portugal", "Spain"] },
    { "id": "vat_registered", "type": "boolean", "label": "Registered for VAT" },
    { "id": "vat_id", "type": "string", "label": "VAT number", "required": true, "pattern": "[A-Z]{2}[0-9A-Z]{8,12}", "visible_when": "vat_registered == true", "help": "Country prefix, e.g. PT509876543" },
    { "id": "website", "type": "url", "label": "Website" },
    { "id": "contact_name", "type": "string", "label": "Contact name", "required": true },
    { "id": "contact_role", "type": "string", "label": "Role" },
    { "id": "contact_email", "type": "email", "label": "Email", "required": true },
    { "id": "phone", "type": "string", "label": "Phone", "pattern": "\\+?[0-9 ]{7,18}" },
    { "id": "preferred_channel", "type": "radio", "label": "Preferred channel", "options": ["Email", "Phone", "Portal"] },
    { "id": "category", "type": "select", "label": "Category", "required": true, "options": ["Logistics", "IT services", "Facilities", "Raw materials", "Consulting"] },
    { "id": "services", "type": "checkbox-group", "label": "Services provided", "min": 1, "options": ["Transport", "Warehousing", "Customs", "Last mile", "Returns"] },
    { "id": "regions", "type": "multiselect", "label": "Regions served", "max": 4, "options": [{ "value": "iberia", "label": "Iberia" }, { "value": "benelux", "label": "Benelux" }, { "value": "dach", "label": "DACH" }, { "value": "nordics", "label": "Nordics" }, { "value": "france", "label": "France" }, { "value": "italy", "label": "Italy" }] },
    { "id": "annual_spend", "type": "currency", "label": "Expected annual spend", "currency": "EUR", "required": true, "min": 0, "max": 5000000 },
    { "id": "payment_terms", "type": "select", "label": "Payment terms", "required": true, "options": ["30 days", "45 days", "60 days"] },
    { "id": "start_date", "type": "date", "label": "Start date", "required": true, "min": "2026-01-01" },
    { "id": "review_at", "type": "datetime", "label": "Kick-off call" },
    { "id": "help_compliance", "type": "markdown", "label": "Compliance help", "text": "**Sanctions screening** ran automatically; its result is shown below." },
    { "id": "sanctions_view", "type": "display", "label": "Sanctions screening", "variable": "sanctions_result" },
    { "id": "iso_certified", "type": "boolean", "label": "ISO 9001 certified" },
    { "id": "certificate_expiry", "type": "date", "label": "Certificate expiry", "required": true, "visible_when": "iso_certified == true" },
    { "id": "insurance_cover", "type": "currency", "label": "Liability insurance", "currency": "EUR", "min": 1000000 },
    { "id": "risk_notes", "type": "textarea", "label": "Risk notes", "maxLength": 2000 },
    { "id": "iban", "type": "string", "label": "IBAN", "required": true, "pattern": "[A-Z]{2}[0-9]{2}[A-Z0-9 ]{11,30}" },
    { "id": "bic", "type": "string", "label": "BIC", "pattern": "[A-Z]{6}[A-Z0-9]{2,5}" },
    { "id": "account_holder", "type": "string", "label": "Account holder", "required": true },
    { "id": "terms_accepted", "type": "boolean", "label": "Supplier accepted the code of conduct", "required": true }
  ],
  "layout": {
    "steps": [
      { "title": "Company", "sections": ["company", "contact"] },
      { "title": "Commercial", "sections": ["commercial"] },
      { "title": "Compliance & bank", "sections": ["compliance", "bank"] }
    ],
    "sections": [
      { "id": "company", "title": "Company", "description": "As registered with the trade register.", "rows": [
        [{ "field": "request_view", "span": 2 }, { "field": "requested_by_view", "span": 2 }],
        [{ "field": "legal_name", "span": 2 }, { "field": "trading_name", "span": 2 }],
        [{ "field": "registration_no", "span": 2 }, "country", "vat_registered"],
        [{ "field": "vat_id", "span": 2 }, { "field": "website", "span": 2 }]
      ] },
      { "id": "contact", "title": "Contact", "rows": [
        [{ "field": "contact_name", "span": 2 }, { "field": "contact_role", "span": 2 }],
        [{ "field": "contact_email", "span": 2 }, "phone", "preferred_channel"]
      ] },
      { "id": "commercial", "title": "Commercial terms", "rows": [
        ["category", "annual_spend", "payment_terms", "start_date"],
        [{ "field": "services", "span": 4 }],
        [{ "field": "regions", "span": 3 }, "review_at"]
      ] },
      { "id": "compliance", "title": "Compliance", "collapsible": true, "rows": [
        [{ "field": "help_compliance", "span": 4 }],
        [{ "field": "sanctions_view", "span": 2 }, "iso_certified", "certificate_expiry"],
        ["insurance_cover", { "field": "risk_notes", "span": 3 }]
      ] },
      { "id": "bank", "title": "Bank details", "rows": [
        [{ "field": "iban", "span": 2 }, "bic", "account_holder"],
        [{ "field": "terms_accepted", "span": 4 }]
      ] }
    ]
  }
}
