#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-}"
MODE="${2:-dev}"

if [[ -z "$COMMAND" || "$COMMAND" == "--help" || "$COMMAND" == "-h" ]]; then
  cat <<'USAGE'
Usage: ./release/abada-platform <doctor|up|down|status|logs> <dev|prod|server> [options]

Profiles:
  dev      Local HTTP on *.localhost with bundled Keycloak and demo accounts
  prod     Public TLS hostnames with an external OIDC provider
  server   Single public VM: TLS for one ABADA_DOMAIN, bundled Keycloak

Options:
  --telemetry        Add the bundled metrics, traces and logs stack
  --env-file PATH    Use an explicit environment file
  --no-pull          Skip image availability/pull checks during doctor
  --agent            Start the first-party agent worker (default in dev and server)
  --no-agent         Skip the agent worker
USAGE
  exit 0
fi

case "$MODE" in
  dev|prod|server) ;;
  *) echo "Error: profile must be 'dev', 'prod' or 'server'" >&2; exit 64 ;;
esac

shift 2 || true
TELEMETRY=false
SKIP_PULL=false
AGENT=false
[[ "$MODE" == "dev" || "$MODE" == "server" ]] && AGENT=true
ENV_FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --telemetry) TELEMETRY=true ;;
    --no-pull) SKIP_PULL=true ;;
    --agent) AGENT=true ;;
    --no-agent) AGENT=false ;;
    --env-file)
      [[ $# -ge 2 ]] || { echo "Error: --env-file requires a path" >&2; exit 64; }
      ENV_FILE="$2"
      shift
      ;;
    *) echo "Error: unknown option '$1'" >&2; exit 64 ;;
  esac
  shift
done

if [[ "$AGENT" == true && "$MODE" == "prod" ]]; then
  echo "Error: --agent is only supported in dev and server modes" >&2
  exit 64
fi

if [[ -z "$ENV_FILE" ]]; then
  ENV_FILE="$ROOT_DIR/.env.$MODE"
fi

if [[ "$MODE" == "dev" && ! -f "$ENV_FILE" ]]; then
  cp "$ROOT_DIR/release/.env.dev.example" "$ENV_FILE"
  echo "Created $ENV_FILE from the safe development defaults."
fi
if [[ "$MODE" == "server" && ! -f "$ENV_FILE" ]]; then
  (umask 077 && cp "$ROOT_DIR/release/.env.server.example" "$ENV_FILE")
  echo "Created $ENV_FILE; set ABADA_DOMAIN and ABADA_ACME_EMAIL, then run this command again."
fi
if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: environment file not found: $ENV_FILE" >&2
  [[ "$MODE" == "prod" ]] && echo "Copy release/.env.prod.example to .env.prod and replace every placeholder." >&2
  exit 66
fi

# Secrets the server profile generates on first use, so an operator only ever
# edits the domain and ACME email.
SERVER_SECRETS=(POSTGRES_PASSWORD KEYCLOAK_DB_PASSWORD KEYCLOAK_ADMIN_PASSWORD
  ABADA_KEYCLOAK_ADMIN_CLIENT_SECRET ABADA_AGENT_OIDC_CLIENT_SECRET
  ABADA_OPERATOR_PASSWORD ABADA_REVIEWER_PASSWORD)

BASE_COMPOSE=(docker compose --env-file "$ENV_FILE" -f "$ROOT_DIR/compose.yaml" -f "$ROOT_DIR/compose.$MODE.yaml")
if [[ "$TELEMETRY" == "true" ]]; then
  BASE_COMPOSE+=(-f "$ROOT_DIR/compose.telemetry.yaml")
fi
COMPOSE=("${BASE_COMPOSE[@]}")
if [[ "$AGENT" == "true" ]]; then
  COMPOSE+=(--profile agent)
fi

require_command() {
  command -v "$1" >/dev/null 2>&1 || { echo "Error: required command '$1' was not found" >&2; exit 69; }
}

validate_production_values() {
  if awk -F= '
    /^[[:space:]]*#/ || NF < 2 || $1 == "GRAFANA_ADMIN_PASSWORD" { next }
    /change-me|example\.com/ { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$ENV_FILE"; then
    echo "Error: production environment still contains change-me/example.com placeholders" >&2
    exit 65
  fi
  local postgres_password version api_host studio_host docs_host acme_email issuer audience oidc_url cors
  postgres_password="$(env_value POSTGRES_PASSWORD)"
  version="$(env_value ABADA_VERSION)"
  api_host="$(env_value ABADA_API_HOST)"
  studio_host="$(env_value ABADA_STUDIO_HOST)"
  docs_host="$(env_value ABADA_DOCS_HOST)"
  acme_email="$(env_value ABADA_ACME_EMAIL)"
  issuer="$(env_value OIDC_ISSUER_URI)"
  audience="$(env_value OIDC_AUDIENCE)"
  oidc_url="$(env_value ABADA_OIDC_URL)"
  cors="$(env_value ABADA_ALLOWED_ORIGINS)"

  [[ ${#postgres_password} -ge 16 ]] || { echo "Error: POSTGRES_PASSWORD must contain at least 16 characters" >&2; exit 65; }
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ && "$version" != "latest" ]] || {
    echo "Error: ABADA_VERSION must be an exact immutable semantic version" >&2; exit 65;
  }
  validate_hostname ABADA_API_HOST "$api_host"
  validate_hostname ABADA_STUDIO_HOST "$studio_host"
  validate_hostname ABADA_DOCS_HOST "$docs_host"
  [[ "$api_host" != "$studio_host" && "$api_host" != "$docs_host" && "$studio_host" != "$docs_host" ]] || {
    echo "Error: API, Studio and docs hostnames must be distinct" >&2; exit 65;
  }
  [[ "$acme_email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || {
    echo "Error: ABADA_ACME_EMAIL must be a valid email address" >&2; exit 65;
  }
  validate_https_url OIDC_ISSUER_URI "$issuer"
  [[ "$audience" =~ ^[A-Za-z0-9._:/-]+$ ]] || {
    echo "Error: OIDC_AUDIENCE must be a non-empty audience identifier" >&2; exit 65;
  }
  validate_https_url ABADA_OIDC_URL "$oidc_url"
  validate_cors "$cors"

  if [[ "$TELEMETRY" == "true" ]]; then
    local grafana_password
    grafana_password="$(awk -F= '$1 == "GRAFANA_ADMIN_PASSWORD" { sub(/^[^=]*=/, ""); print; exit }' "$ENV_FILE")"
    if [[ ${#grafana_password} -lt 16 || "$grafana_password" == *change-me* ]]; then
      echo "Error: telemetry requires a non-placeholder GRAFANA_ADMIN_PASSWORD with at least 16 characters" >&2
      exit 65
    fi
  fi
}

validate_server_values() {
  if awk -F= '
    /^[[:space:]]*#/ || NF < 2 { next }
    /change-me|example\.com/ { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$ENV_FILE"; then
    echo "Error: server environment still contains change-me/example.com placeholders" >&2
    exit 65
  fi
  local domain acme_email key value
  domain="$(env_value ABADA_DOMAIN)"
  acme_email="$(env_value ABADA_ACME_EMAIL)"
  [[ -n "$domain" ]] || { echo "Error: set ABADA_DOMAIN in $ENV_FILE (for example demo.example.org or 34-56-78-90.sslip.io)" >&2; exit 65; }
  validate_hostname ABADA_DOMAIN "$domain"
  [[ "$acme_email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || {
    echo "Error: ABADA_ACME_EMAIL must be a valid email address" >&2; exit 65;
  }
  validate_https_url ABADA_ACME_CA_SERVER "$(env_value ABADA_ACME_CA_SERVER)"
  for key in "${SERVER_SECRETS[@]}"; do
    value="$(env_value "$key")"
    [[ ${#value} -ge 16 ]] || { echo "Error: $key must contain at least 16 characters" >&2; exit 65; }
  done
  for key in ABADA_ENGINE_IMAGE ABADA_STUDIO_IMAGE ABADA_DOCS_IMAGE ABADA_AGENT_WORKER_IMAGE; do
    value="$(env_value "$key")"
    [[ "$value" =~ :[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || {
      echo "Error: $key must pin an exact immutable semantic version" >&2; exit 65;
    }
  done
  if [[ "$TELEMETRY" == "true" ]]; then
    value="$(env_value GRAFANA_ADMIN_PASSWORD)"
    [[ ${#value} -ge 16 ]] || {
      echo "Error: telemetry requires a non-placeholder GRAFANA_ADMIN_PASSWORD with at least 16 characters" >&2; exit 65;
    }
  fi
}

generate_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  elif [[ -r /dev/urandom ]]; then
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
  else
    echo "Error: cannot securely generate secrets" >&2
    exit 69
  fi
}

set_env_value() {
  local key="$1" value="$2" temp_file
  temp_file="$(umask 077 && mktemp "${ENV_FILE}.tmp.XXXXXX")"
  awk -v key="$key" -v value="$value" '
    index($0, key "=") == 1 {
      if (!updated) print key "=" value
      updated = 1
      next
    }
    { print }
    END { if (!updated) print key "=" value }
  ' "$ENV_FILE" >"$temp_file"
  mv "$temp_file" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

generate_server_secrets() {
  local key generated=()
  for key in "${SERVER_SECRETS[@]}"; do
    if [[ -z "$(env_value "$key")" ]]; then
      set_env_value "$key" "$(generate_secret)"
      generated+=("$key")
    fi
  done
  if [[ ${#generated[@]} -gt 0 ]]; then
    echo "Generated ${generated[*]} in $ENV_FILE."
  fi
  chmod 600 "$ENV_FILE"
}

validate_telemetry_values() {
  local telemetry_enabled endpoint sdk_disabled
  telemetry_enabled="$(env_value ABADA_TELEMETRY_ENABLED)"
  endpoint="$(env_value ABADA_TELEMETRY_OTLP_ENDPOINT)"
  sdk_disabled="$(env_value OTEL_SDK_DISABLED)"
  [[ "$telemetry_enabled" == "true" || "$telemetry_enabled" == "false" ]] || {
    echo "Error: ABADA_TELEMETRY_ENABLED must be true or false" >&2; exit 65;
  }
  if [[ "$TELEMETRY" != "true" && "$telemetry_enabled" == "true" ]]; then
    [[ "$endpoint" =~ ^https?://[^[:space:]]+$ ]] || {
      echo "Error: external telemetry requires a valid ABADA_TELEMETRY_OTLP_ENDPOINT" >&2; exit 65;
    }
    [[ "$sdk_disabled" == "false" ]] || {
      echo "Error: external telemetry requires OTEL_SDK_DISABLED=false" >&2; exit 65;
    }
  elif [[ "$TELEMETRY" != "true" && "$telemetry_enabled" == "false" ]]; then
    [[ -z "$endpoint" && "$sdk_disabled" == "true" ]] || {
      echo "Error: disabled telemetry requires an empty endpoint and OTEL_SDK_DISABLED=true" >&2; exit 65;
    }
  fi
}

env_value() {
  local key="$1"
  awk -v key="$key" 'index($0, key "=") == 1 { sub(/^[^=]*=/, ""); print; exit }' "$ENV_FILE"
}

validate_hostname() {
  local key="$1" value="$2"
  if [[ ! "$value" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ || "$value" != *.* || "$value" == *..* || "$value" == *://* || "$value" == */* || "$value" == "localhost" || "$value" == *.localhost ]]; then
    echo "Error: $key must be a DNS hostname without a scheme or path" >&2
    exit 65
  fi
}

validate_https_url() {
  local key="$1" value="$2"
  if [[ ! "$value" =~ ^https://[^[:space:]/]+(/[^[:space:]]*)?$ || "$value" == *"*"* ]]; then
    echo "Error: $key must be an HTTPS URL without wildcards" >&2
    exit 65
  fi
}

validate_cors() {
  local value="$1" origin
  IFS=',' read -r -a origins <<<"$value"
  [[ ${#origins[@]} -gt 0 ]] || { echo "Error: ABADA_ALLOWED_ORIGINS is required" >&2; exit 65; }
  for origin in "${origins[@]}"; do
    if [[ ! "$origin" =~ ^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]+)?$ || "$origin" == *"*"* ]]; then
      echo "Error: every production CORS origin must be an exact HTTPS origin" >&2
      exit 65
    fi
  done
}

check_ports() {
  command -v lsof >/dev/null 2>&1 || return 0
  if [[ -n "$("${COMPOSE[@]}" ps --status running -q traefik 2>/dev/null)" ]]; then
    return 0
  fi
  local ports=(80)
  [[ "$MODE" == "prod" || "$MODE" == "server" ]] && ports+=(443)
  if [[ "$TELEMETRY" == "true" ]]; then
    local grafana_port
    grafana_port="$(env_value GRAFANA_PORT)"
    ports+=("${grafana_port:-3000}")
  fi
  local port
  for port in "${ports[@]}"; do
    if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "Error: TCP port $port is already in use" >&2
      exit 69
    fi
  done
}

check_docker_storage() {
  local probe_volume="abada-preflight-${USER:-user}-$$"
  if ! docker volume create "$probe_volume" >/dev/null; then
    echo "Error: Docker cannot create named-volume storage" >&2
    exit 73
  fi
  if ! docker volume inspect "$probe_volume" >/dev/null; then
    docker volume rm "$probe_volume" >/dev/null 2>&1 || true
    echo "Error: Docker cannot inspect named-volume storage" >&2
    exit 73
  fi
  docker volume rm "$probe_volume" >/dev/null || {
    echo "Error: Docker could not clean up the preflight storage probe" >&2
    exit 73
  }
}

configure_rc1_arm64_compatibility() {
  local host_arch version engine_image
  host_arch="$(docker info --format '{{.Architecture}}')"
  case "$host_arch" in
    arm64|aarch64) ;;
    *) return 0 ;;
  esac

  version="$(env_value ABADA_VERSION)"
  engine_image="$(env_value ABADA_ENGINE_IMAGE)"
  if [[ "$version" != "1.0.0-rc.1" ]] &&
     [[ "$engine_image" != *":1.0.0-rc.1" ]]; then
    return 0
  fi

  if [[ -z "${DOCKER_DEFAULT_PLATFORM:-}" ]]; then
    export DOCKER_DEFAULT_PLATFORM=linux/amd64
    cat >&2 <<'NOTICE'
Notice: Abada 1.0.0-rc.1 images were published for linux/amd64 only.
This ARM host will run that release through Docker's amd64 compatibility mode.
Subsequent Abada release images are required to include native linux/arm64.
NOTICE
  fi
}

doctor() {
  require_command docker
  [[ "$MODE" == "prod" ]] && validate_production_values
  if [[ "$MODE" == "server" ]]; then
    generate_server_secrets
    validate_server_values
  fi
  validate_telemetry_values
  docker info >/dev/null
  configure_rc1_arm64_compatibility
  docker compose version >/dev/null
  [[ -w "$ROOT_DIR" ]] || { echo "Error: $ROOT_DIR is not writable" >&2; exit 73; }
  check_docker_storage
  "${COMPOSE[@]}" config --quiet
  check_ports
  if [[ "$SKIP_PULL" != "true" ]]; then
    "${COMPOSE[@]}" pull --quiet
  fi
  echo "Preflight passed: profile=$MODE telemetry=$TELEMETRY agent=$AGENT"
}

configure_console_style() {
  RESET=""
  BOLD=""
  DIM=""
  GREEN=""
  CYAN=""
  UNDERLINE=""
  if [[ -t 1 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR+x}" ]]; then
    RESET=$'\033[0m'
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    GREEN=$'\033[32m'
    CYAN=$'\033[36m'
    UNDERLINE=$'\033[4m'
  fi
}

print_section() {
  printf '\n%b%s%b\n' "$BOLD" "$1" "$RESET"
}

print_url() {
  printf '  %b%-12s%b %b%b%s%b\n' "$DIM" "$1" "$RESET" "$CYAN" "$UNDERLINE" "$2" "$RESET"
}

print_value() {
  printf '  %b%-12s%b %s\n' "$DIM" "$1" "$RESET" "$2"
}

# Keycloak imports realm-dev.json only into an empty database, so a realm
# created before the Abada login theme existed never selects it. Apply it on
# every dev start; the update is idempotent and a failure only warns.
apply_dev_login_theme() {
  local user password
  user="$(env_value KEYCLOAK_ADMIN_USERNAME)"
  password="$(env_value KEYCLOAK_ADMIN_PASSWORD)"
  if "${BASE_COMPOSE[@]}" exec -T keycloak /opt/keycloak/bin/kcadm.sh config credentials \
      --server http://127.0.0.1:8080 --realm master \
      --user "${user:-admin}" --password "${password:-admin}" >/dev/null 2>&1 \
    && "${BASE_COMPOSE[@]}" exec -T keycloak /opt/keycloak/bin/kcadm.sh update realms/abada-dev \
      -s loginTheme=abada -s 'displayName=Abada Studio' >/dev/null 2>&1; then
    echo "Applied the Abada login theme to the abada-dev realm."
  else
    echo "Warning: could not apply the Abada login theme; see docker/keycloak/themes/README.md" >&2
  fi
}

# The server realm is imported without users, secrets or public URLs. Apply the
# domain, client secret and the two Studio accounts on every start; each step
# is idempotent, so a rerun converges a changed .env.server onto Keycloak.
kc_server() {
  "${BASE_COMPOSE[@]}" exec -T keycloak /opt/keycloak/bin/kcadm.sh "$@"
}

ensure_realm_user() {
  local username="$1" password="$2" enabled="$3" user_id group group_id
  shift 3
  user_id="$(kc_server get users -r abada -q username="$username" -q exact=true --fields id --format csv --noquotes)"
  if [[ -z "$user_id" ]]; then
    kc_server create users -r abada -s username="$username" -s enabled="$enabled" >/dev/null
    user_id="$(kc_server get users -r abada -q username="$username" -q exact=true --fields id --format csv --noquotes)"
  else
    kc_server update "users/$user_id" -r abada -s enabled="$enabled" >/dev/null
  fi
  [[ "$enabled" == "true" ]] || return 0
  kc_server set-password -r abada --userid "$user_id" --new-password "$password" >/dev/null
  for group in "$@"; do
    group_id="$(kc_server get groups -r abada -q search="$group" --fields id,name --format csv --noquotes \
      | awk -F, -v name="$group" '$2 == name { print $1; exit }')"
    kc_server update "users/$user_id/groups/$group_id" -r abada -n >/dev/null
  done
}

configure_server_realm() {
  local domain frontend_id admin_api_id reviewer_enabled
  domain="$(env_value ABADA_DOMAIN)"
  kc_server config credentials --server http://127.0.0.1:8080 --realm master \
    --user "$(env_value KEYCLOAK_ADMIN_USERNAME)" --password "$(env_value KEYCLOAK_ADMIN_PASSWORD)" >/dev/null

  frontend_id="$(kc_server get clients -r abada -q clientId=abada-frontend --fields id --format csv --noquotes)"
  kc_server update "clients/$frontend_id" -r abada \
    -s "redirectUris=[\"https://$domain/*\"]" \
    -s "webOrigins=[\"https://$domain\"]" >/dev/null
  admin_api_id="$(kc_server get clients -r abada -q clientId=abada-admin-api --fields id --format csv --noquotes)"
  kc_server update "clients/$admin_api_id" -r abada \
    -s "secret=$(env_value ABADA_KEYCLOAK_ADMIN_CLIENT_SECRET)" >/dev/null

  # The AI Lead Triage starter is wired to alice (operator) and bob (reviewer).
  ensure_realm_user alice "$(env_value ABADA_OPERATOR_PASSWORD)" true \
    abada-task-user abada-process-controller abada-deployer abada-operator \
    abada-insight-reviewer abada-project-creator abada-admin
  reviewer_enabled="$(env_value ABADA_REVIEWER_ENABLED)"
  [[ "$reviewer_enabled" == "false" ]] || reviewer_enabled=true
  ensure_realm_user bob "$(env_value ABADA_REVIEWER_PASSWORD)" "$reviewer_enabled" \
    abada-task-user abada-process-controller
  echo "Configured the abada realm for https://$domain."
}

provision_server_agent() {
  local domain
  domain="$(env_value ABADA_DOMAIN)"
  # Provisioning runs on the VM itself: resolve the public names to the local
  # Traefik so it does not depend on DNS propagation or NAT hairpinning.
  ABADA_ENV_FILE="$ENV_FILE" \
  ABADA_KEYCLOAK_REALM=abada \
  ABADA_KEYCLOAK_CONTAINER="$("${BASE_COMPOSE[@]}" ps -q keycloak)" \
  ABADA_PROVISION_API_URL="https://api.$domain/api" \
  ABADA_PROVISION_OIDC_URL="https://auth.$domain" \
  ABADA_PROVISION_CURL_RESOLVE="${ABADA_PROVISION_CURL_RESOLVE:-api.$domain:443:127.0.0.1,auth.$domain:443:127.0.0.1}" \
  KEYCLOAK_ADMIN_USERNAME="$(env_value KEYCLOAK_ADMIN_USERNAME)" \
  KEYCLOAK_ADMIN_PASSWORD="$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
    "$ROOT_DIR/scripts/dev/provision-agent-worker.sh"
}

print_success_panel() {
  local telemetry_status management_env management_telemetry root_quoted env_quoted grafana_port
  configure_console_style

  telemetry_status="Off"
  if [[ "$TELEMETRY" == "true" ]]; then
    telemetry_status="Bundled"
  elif [[ "$(env_value ABADA_TELEMETRY_ENABLED)" == "true" ]]; then
    telemetry_status="External OTLP"
  fi

  printf '\n%b%s%b\n' "$CYAN" '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━' "$RESET"
  printf '  %bABADA PLATFORM%b\n' "$BOLD" "$RESET"
  if [[ "$MODE" == "dev" ]]; then
    printf '  %b✓ Ready%b  Development · Telemetry %s\n' "$GREEN" "$RESET" "$telemetry_status"
  elif [[ "$MODE" == "server" ]]; then
    printf '  %b✓ Ready%b  Server · Telemetry %s\n' "$GREEN" "$RESET" "$telemetry_status"
  else
    printf '  %b✓ Ready%b  Production · Telemetry %s\n' "$GREEN" "$RESET" "$telemetry_status"
  fi
  printf '%b%s%b\n' "$CYAN" '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━' "$RESET"

  print_section "Open Abada"
  if [[ "$MODE" == "dev" ]]; then
    print_url "Studio" "http://studio.localhost"
    print_url "Docs" "http://docs.localhost"
    print_url "Engine API" "http://api.localhost/api/v1/info"
    print_url "Keycloak" "http://keycloak.localhost"
  elif [[ "$MODE" == "server" ]]; then
    local domain
    domain="$(env_value ABADA_DOMAIN)"
    print_url "Studio" "https://$domain"
    print_url "Docs" "https://docs.$domain"
    print_url "Engine API" "https://api.$domain/api/v1/info"
    print_url "Keycloak" "https://auth.$domain"
  else
    print_url "Studio" "https://$(env_value ABADA_STUDIO_HOST)"
    print_url "Docs" "https://$(env_value ABADA_DOCS_HOST)"
    print_url "Engine API" "https://$(env_value ABADA_API_HOST)/api/v1/info"
    print_value "Identity" "External OIDC"
  fi
  if [[ "$TELEMETRY" == "true" ]]; then
    grafana_port="$(env_value GRAFANA_PORT)"
    print_url "Grafana" "http://127.0.0.1:${grafana_port:-3000}"
  fi

  if [[ "$MODE" == "dev" ]]; then
    print_section "Development accounts"
    print_value "Studio user" "alice / alice"
    print_value "Keycloak" "admin / admin"

    print_section "First run"
    printf '  1. Open %bStudio%b and sign in as %balice%b.\n' "$BOLD" "$RESET" "$BOLD" "$RESET"
    printf '  2. Open the pre-deployed %bAI Lead Triage%b process in the Designer.\n' "$BOLD" "$RESET"
    printf '  3. Start HIGH, MEDIUM or LOW examples, then inspect %bTasks%b, %bOperations%b and %bInsight%b.\n' "$BOLD" "$RESET" "$BOLD" "$RESET" "$BOLD" "$RESET"
  elif [[ "$MODE" == "server" ]]; then
    print_section "Accounts"
    print_value "Operator" "alice (ABADA_OPERATOR_PASSWORD)"
    [[ "$(env_value ABADA_REVIEWER_ENABLED)" == "false" ]] || print_value "Reviewer" "bob (ABADA_REVIEWER_PASSWORD)"
    print_value "Keycloak" "$(env_value KEYCLOAK_ADMIN_USERNAME) (KEYCLOAK_ADMIN_PASSWORD)"
    print_value "Passwords" "$ENV_FILE"

    print_section "First run"
    printf '  1. Sign in to %bStudio%b once as %balice%b; this seeds the AI Lead Triage starter.\n' "$BOLD" "$RESET" "$BOLD" "$RESET"
    printf '  2. Certificates are issued on the first request to each host; allow a minute.\n'
  fi

  printf -v root_quoted '%q' "$ROOT_DIR"
  management_env=""
  if [[ "$ENV_FILE" != "$ROOT_DIR/.env.$MODE" ]]; then
    printf -v env_quoted '%q' "$ENV_FILE"
    management_env=" --env-file $env_quoted"
  fi
  management_telemetry=""
  [[ "$TELEMETRY" == "true" ]] && management_telemetry=" --telemetry"

  print_section "Manage"
  printf '  %bcd%b %s\n' "$DIM" "$RESET" "$root_quoted"
  printf '  %bLogs%b  ./release/abada-platform logs %s%s%s\n' "$DIM" "$RESET" "$MODE" "$management_env" "$management_telemetry"
  printf '  %bStop%b  ./release/abada-platform down %s%s%s\n' "$DIM" "$RESET" "$MODE" "$management_env" "$management_telemetry"
  printf '\n%b✓ All required containers passed their health checks.%b\n\n' "$GREEN" "$RESET"
}

case "$COMMAND" in
  doctor) doctor ;;
  up)
    doctor
    if [[ "$AGENT" == "true" ]]; then
      "${BASE_COMPOSE[@]}" up -d --wait
      [[ "$MODE" == "server" ]] && configure_server_realm
      echo "Provisioning the first-party agent worker..."
      if [[ "$MODE" == "server" ]]; then
        provision_server_agent
      else
        ABADA_ENV_FILE="$ENV_FILE" "$ROOT_DIR/scripts/dev/provision-agent-worker.sh"
      fi
      "${COMPOSE[@]}" up -d --wait abada-agent-worker
    else
      "${COMPOSE[@]}" up -d --wait
      [[ "$MODE" == "server" ]] && configure_server_realm
    fi
    if [[ "$MODE" == "dev" ]]; then apply_dev_login_theme; fi
    print_success_panel
    ;;
  down) "${COMPOSE[@]}" down ;;
  status) "${COMPOSE[@]}" ps ;;
  logs) "${COMPOSE[@]}" logs -f ;;
  *) echo "Error: unknown command '$COMMAND'" >&2; exit 64 ;;
esac
