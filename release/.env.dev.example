ABADA_ENGINE_IMAGE=ghcr.io/bashizip/abada-engine:1.0.0-rc.2
ABADA_TENDA_IMAGE=ghcr.io/bashizip/abada-tenda:1.0.0-rc.2
ABADA_ORUN_IMAGE=ghcr.io/bashizip/abada-orun:1.0.0-rc.2
ABADA_STUDIO_IMAGE=ghcr.io/bashizip/abada-studio:1.0.0-rc.2
ABADA_DOCS_IMAGE=ghcr.io/bashizip/abada-docs:1.0.0-rc.2
ABADA_AGENT_WORKER_IMAGE=ghcr.io/bashizip/abada-agent-worker:1.0.0-rc.2
POSTGRES_PASSWORD=abada_dev_password
KEYCLOAK_DB_PASSWORD=abada_dev_keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=abada_dev_grafana
ABADA_ENVIRONMENT=development
ABADA_TRACING_SAMPLING_PROBABILITY=1.0
ABADA_TELEMETRY_ENABLED=false
ABADA_TELEMETRY_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true

# Insight Engine (optional, disabled by default)
ABADA_INSIGHT_ENABLED=false
ABADA_LLM_BASE_URL=
ABADA_LLM_API_KEY=
ABADA_LLM_MODEL=deepseek/deepseek-v4-flash-free

# First-party agent worker (activate with: docker compose --profile agent ...)
ABADA_AGENT_ENGINE_TOKEN=
ABADA_AGENT_OIDC_TOKEN_URL=
ABADA_AGENT_OIDC_CLIENT_ID=
ABADA_AGENT_OIDC_CLIENT_SECRET=
ABADA_AGENT_LLM_BASE_URL=
ABADA_AGENT_LLM_API_KEY=
ABADA_AGENT_LLM_MODEL=gpt-5-mini
ABADA_AGENT_ALLOWED_TOOLS=
ABADA_AGENT_MAX_TASKS=4
ABADA_AGENT_LOCK_DURATION_MS=120000
