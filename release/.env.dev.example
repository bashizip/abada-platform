ABADA_ENGINE_IMAGE=ghcr.io/bashizip/abada-engine:1.0.0-rc.3
ABADA_STUDIO_IMAGE=ghcr.io/bashizip/abada-studio:1.0.0-rc.3
ABADA_DOCS_IMAGE=ghcr.io/bashizip/abada-docs:1.0.0-rc.3
ABADA_AGENT_WORKER_IMAGE=ghcr.io/bashizip/abada-agent-worker:1.0.0-rc.3
POSTGRES_PASSWORD=abada_dev_password
KEYCLOAK_DB_PASSWORD=abada_dev_keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=abada_dev_grafana
ABADA_ENVIRONMENT=development
ABADA_TRACING_SAMPLING_PROBABILITY=1.0
ABADA_TELEMETRY_ENABLED=false
ABADA_TELEMETRY_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true

# Insight Engine (optional, disabled by default)
ABADA_INSIGHT_ENABLED=false
ABADA_LLM_BASE_URL=
ABADA_LLM_API_KEY=
ABADA_LLM_MODEL=deepseek/deepseek-v4-flash-free

# First-party agent worker (started automatically by: ./release/abada-platform up dev)
#
# The dev engine authenticates with the bundled Keycloak (OIDC), so the
# worker uses OIDC client credentials for a confidential service-account
# client in the abada-dev realm. The launcher generates the secret below when
# empty, creates or updates that client, assigns the abada-worker group, and
# registers the global abada:agent capability before it starts the worker.
ABADA_AGENT_ENGINE_TOKEN=
ABADA_AGENT_OIDC_TOKEN_URL=http://keycloak.localhost/realms/abada-dev/protocol/openid-connect/token
ABADA_AGENT_OIDC_CLIENT_ID=abada-agent-worker
# Generated automatically on first `up dev`; do not commit the resulting .env.dev.
ABADA_AGENT_OIDC_CLIENT_SECRET=
# Gemini OpenAI-compatible endpoint; the worker sends the key as a bearer
# token. Google retired the legacy REST :generateContent surface for new keys,
# so gemini* models are served through /v1beta/openai/chat/completions.
ABADA_AGENT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ABADA_AGENT_LLM_API_KEY=
ABADA_AGENT_LLM_MODEL=gemini-3.6-flash
# Optional OpenAI-compatible endpoint for non-Gemini models (DeepSeek, GPT,
# OpenRouter, a local gateway, ...). Unset values fall back to the Gemini
# endpoint above, so this is purely additive.
ABADA_AGENT_OPENAI_BASE_URL=
ABADA_AGENT_OPENAI_API_KEY=
ABADA_AGENT_ALLOWED_TOOLS=
# Comma-separated model identifiers the worker registers as its capabilities;
# empty means all models in the engine allow-list.
ABADA_AGENT_MODELS=
ABADA_AGENT_POLL_INTERVAL_MS=1000
ABADA_AGENT_MAX_TASKS=4
ABADA_AGENT_LOCK_DURATION_MS=120000
