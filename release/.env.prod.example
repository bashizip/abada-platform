# Copy this file to .env.prod and replace every change-me/example.com value.
ABADA_REGISTRY=ghcr.io/bashizip
ABADA_VERSION=change-me-version
POSTGRES_PASSWORD=change-me-with-a-long-random-password

ABADA_API_HOST=api.example.com
ABADA_STUDIO_HOST=studio.example.com
ABADA_DOCS_HOST=docs.example.com
ABADA_ACME_EMAIL=operations@example.com
ABADA_ALLOWED_ORIGINS=https://studio.example.com

# Studio uses the Keycloak browser adapter. The provider is externally managed
# in production; it is not part of the production stack.
OIDC_ISSUER_URI=https://identity.example.com/realms/abada
OIDC_AUDIENCE=change-me-api-audience
# Optional private back-channel URL; leave blank to discover keys from issuer.
OIDC_JWK_SET_URI=
ABADA_OIDC_URL=https://identity.example.com
ABADA_OIDC_REALM=abada
ABADA_OIDC_CLIENT_ID=abada-frontend

# Required only when compose.telemetry.yaml is enabled.
GRAFANA_ADMIN_PASSWORD=change-me-with-a-long-random-password
GRAFANA_PORT=3000
ABADA_ENVIRONMENT=production
ABADA_TRACING_SAMPLING_PROBABILITY=0.1

# External OTLP mode (without compose.telemetry.yaml): set all three values.
ABADA_TELEMETRY_ENABLED=false
ABADA_TELEMETRY_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true

# Insight Engine (optional, disabled by default)
ABADA_INSIGHT_ENABLED=false
# AI providers. Prefer Studio > Settings > AI Providers: keys saved there are
# encrypted in the database, take precedence over these variables and serve
# agent tasks, Insight and APL authoring alike. The variables below are an
# optional developer/bootstrap default read by the engine (not the worker).
# Per-provider keys; base URLs default to each provider's public endpoint
# (override with ABADA_LLM_<PROVIDER>_BASE_URL).
ABADA_LLM_GEMINI_API_KEY=
ABADA_LLM_OPENAI_API_KEY=
ABADA_LLM_ANTHROPIC_API_KEY=
ABADA_LLM_DEEPSEEK_API_KEY=
ABADA_LLM_OPENROUTER_API_KEY=
# Or one default provider (any OpenAI-compatible endpoint), also used by Insight.
# ABADA_LLM_PROVIDER: gemini, openai, anthropic, deepseek, openrouter or
# openai-compatible (inferred from the base URL when empty).
ABADA_LLM_PROVIDER=
ABADA_LLM_BASE_URL=
ABADA_LLM_API_KEY=
ABADA_LLM_MODEL=gemini-3.6-flash
# Required: encrypts keys saved in Studio. Generate once with
# `openssl rand -base64 32`, back it up, and never change it.
ABADA_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# Optional first-party agent worker. Prefer OIDC client credentials with the
# worker:execute scope; a static short-lived token is supported for testing.
ABADA_AGENT_WORKER_IMAGE=${ABADA_REGISTRY}/abada-agent-worker:${ABADA_VERSION}
ABADA_AGENT_ENGINE_TOKEN=change-me-short-lived-worker-token
ABADA_AGENT_OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
ABADA_AGENT_OIDC_CLIENT_ID=abada-agent-worker
ABADA_AGENT_OIDC_CLIENT_SECRET=change-me-client-secret
ABADA_AGENT_ALLOWED_TOOLS=
# Comma-separated model identifiers the worker registers as its capabilities;
# empty means all models in the engine allow-list.
ABADA_AGENT_MODELS=
ABADA_AGENT_MAX_TASKS=4
ABADA_AGENT_LOCK_DURATION_MS=120000
