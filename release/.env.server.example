# Self-contained single-VM profile (./release/abada-platform up server).
# Set ABADA_DOMAIN and ABADA_ACME_EMAIL; leave the secrets empty and the
# launcher generates them on first start. Keep the resulting .env.server
# private (mode 600) and back it up with the volumes.
#
# DNS: point both ${ABADA_DOMAIN} and *.${ABADA_DOMAIN} at the VM public IP.
# Without DNS, use <ip-with-dashes>.sslip.io, for example 34-56-78-90.sslip.io.
ABADA_DOMAIN=
ABADA_ACME_EMAIL=
# Let's Encrypt staging for rehearsals (untrusted certificates, no rate limit):
# https://acme-staging-v02.api.letsencrypt.org/directory
ABADA_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

ABADA_ENGINE_IMAGE=ghcr.io/bashizip/abada-engine:1.0.0-rc.8
ABADA_STUDIO_IMAGE=ghcr.io/bashizip/abada-studio:1.0.0-rc.8
ABADA_DOCS_IMAGE=ghcr.io/bashizip/abada-docs:1.0.0-rc.8
ABADA_AGENT_WORKER_IMAGE=ghcr.io/bashizip/abada-agent-worker:1.0.0-rc.8

# Generated on first start when empty.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
ABADA_KEYCLOAK_ADMIN_CLIENT_SECRET=
ABADA_AGENT_OIDC_CLIENT_SECRET=

# Studio accounts created in the bundled "abada" realm, with generated
# passwords. The AI Lead Triage starter is wired to these two usernames:
# alice is the operator (every Abada role, seeds the starter on first sign-in)
# and bob is the starter's human reviewer (runs and reviews, cannot deploy).
ABADA_OPERATOR_PASSWORD=
ABADA_REVIEWER_ENABLED=true
ABADA_REVIEWER_PASSWORD=

ABADA_ENVIRONMENT=demo
ABADA_STARTER_WORKFLOW_ENABLED=true
ABADA_TRACING_SAMPLING_PROBABILITY=0.1
ABADA_TELEMETRY_ENABLED=false
ABADA_TELEMETRY_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true
# Required only when the bundled telemetry overlay (--telemetry) is enabled;
# Grafana stays bound to 127.0.0.1 (use an SSH tunnel).
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# Governed Insight Engine.
ABADA_INSIGHT_ENABLED=true
# AI providers. Prefer Studio > Settings > AI Providers: keys saved there are
# encrypted in the database, take precedence over these variables and serve
# agent tasks, Insight and APL authoring alike. The variables below are an
# optional developer/bootstrap default read by the engine (not the worker).
# Per-provider keys; base URLs default to each provider's public endpoint
# (override with ABADA_LLM_<PROVIDER>_BASE_URL).
ABADA_LLM_GEMINI_API_KEY=
ABADA_LLM_OPENAI_API_KEY=
ABADA_LLM_ANTHROPIC_API_KEY=
ABADA_LLM_DEEPSEEK_API_KEY=
ABADA_LLM_OPENROUTER_API_KEY=
# Or one default provider (any OpenAI-compatible endpoint), also used by Insight.
# ABADA_LLM_PROVIDER: gemini, openai, anthropic, deepseek, openrouter or
# openai-compatible (inferred from the base URL when empty).
ABADA_LLM_PROVIDER=
ABADA_LLM_BASE_URL=
ABADA_LLM_API_KEY=
ABADA_LLM_MODEL=gemini-3.6-flash
# Encrypts keys saved in Studio (base64, 32 bytes). Generated on first
# `up server`; keep it with your backups and never change it, or saved keys
# become unreadable and must be entered again.
ABADA_ENCRYPTION_KEY=

# First-party agent worker. A public demo spends real LLM quota: use a key with
# a spending cap and keep concurrency low.
ABADA_AGENT_ENGINE_TOKEN=
ABADA_AGENT_ALLOWED_TOOLS=
# Local acknowledgements for the Lead Triage starter's demo adapters.
ABADA_AGENT_LOCAL_ACK_TOPICS=demo.crm.upsert,demo.nurture.enqueue
ABADA_AGENT_MODELS=
ABADA_AGENT_POLL_INTERVAL_MS=1000
ABADA_AGENT_MAX_TASKS=2
ABADA_AGENT_LOCK_DURATION_MS=120000
